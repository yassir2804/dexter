    {
      "name": "1. Profile Summary",
      "item": [
        {
          "name": "GET profile-summary (userId={{userId}})",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('ProfileSummaryDto tiene todos los campos esperados', () => {",
                  "    const p = pm.response.json();",
                  "    pm.expect(p).to.have.property('initials').that.is.a('string');",
                  "    pm.expect(p).to.have.property('firstName');",
                  "    pm.expect(p).to.have.property('lastName');",
                  "    pm.expect(p).to.have.property('bio');",
                  "    pm.expect(p).to.have.property('country');",
                  "    pm.expect(p).to.have.property('rating');",
                  "    pm.expect(p).to.have.property('totalSessions').that.is.a('number');",
                  "    pm.expect(p).to.have.property('totalMatches').that.is.a('number');",
                  "    pm.expect(p).to.have.property('skillsOffered').that.is.an('array');",
                  "    pm.expect(p).to.have.property('skillsSought').that.is.an('array');",
                  "    pm.expect(p).to.have.property('reviews').that.is.an('array');",
                  "});",
                  "pm.test('Initials son 2 letras mayúsculas', () => {",
                  "    pm.expect(pm.response.json().initials).to.match(/^[A-Z]{1,2}$/);",
                  "});",
                  "pm.test('Reviews tienen estructura válida', () => {",
                  "    const reviews = pm.response.json().reviews || [];",
                  "    reviews.forEach(r => {",
                  "        pm.expect(r).to.have.property('reviewerName');",
                  "        pm.expect(r).to.have.property('rating').that.is.a('number');",
                  "        pm.expect(r.rating).to.be.within(1, 5);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/profile-summary?userId={{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "profile-summary"
              ],
              "query": [
                {
                  "key": "userId",
                  "value": "{{userId}}"
                }
              ]
            },
            "description": "Devuelve ProfileSummaryDto con initials, nombre, bio, skills offered/sought, reviews, rating, totales."
          }
