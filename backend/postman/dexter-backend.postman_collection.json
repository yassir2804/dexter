              "raw": "{\n  \"email\": \"newman-{{$timestamp}}@dexter.app\",\n  \"password\": \"test1234\",\n  \"firstName\": \"Newman\",\n  \"lastName\": \"Test\",\n  \"country\": \"CR\",\n  \"skillsToTeach\": [],\n  \"skillsToLearn\": []\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
