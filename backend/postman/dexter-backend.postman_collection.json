          "name": "GET matches (todos del user) — guarda matchId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Respuesta es array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('Cada match tiene estructura MatchDto', () => {",
                  "    pm.response.json().forEach(m => {",
                  "        pm.expect(m).to.have.property('id').that.is.a('number');",
                  "        pm.expect(m).to.have.property('initiatorId').that.is.a('number');",
                  "        pm.expect(m).to.have.property('receiverId').that.is.a('number');",
                  "        pm.expect(m).to.have.property('status').that.is.a('string');",
                  "        pm.expect(['PENDING','ACCEPTED','REJECTED','CANCELLED']).to.include(m.status);",
                  "    });",
                  "});",
                  "",
                  "const list = pm.response.json();",
                  "if (list.length > 0) {",
                  "    pm.collectionVariables.set('matchId', String(list[0].id));",
                  "    console.log('matchId guardado:', list[0].id);",
                  "}"
                ]
              }
            }
