          "name": "GET match-summaries (Home)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Respuesta es array', () => pm.expect(pm.response.json()).to.be.an('array'));",
                  "pm.test('MatchSummaryDto tiene campos esperados', () => {",
                  "    const list = pm.response.json();",
                  "    if (list.length > 0) {",
                  "        const m = list[0];",
                  "        pm.expect(m).to.have.property('initials');",
                  "        pm.expect(m).to.have.property('name');",
                  "        pm.expect(m).to.have.property('offers');",
                  "        pm.expect(m).to.have.property('seeks');",
                  "        pm.expect(m).to.have.property('rating');",
                  "        pm.expect(m).to.have.property('sessions').that.is.a('number');",
                  "        pm.expect(m).to.have.property('compatibilityPercent');",
                  "    }",
                  "});",
                  "pm.test('compatibilityPercent tiene formato NN%', () => {",
                  "    const list = pm.response.json();",
                  "    list.forEach(m => {",
                  "        if (m.compatibilityPercent && m.compatibilityPercent !== '—') {",
                  "            pm.expect(m.compatibilityPercent).to.match(/^\\d+%$/);",
                  "        }",
                  "    });",
                  "});"
                ]
              }
            }
          ],
