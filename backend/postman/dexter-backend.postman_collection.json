        {
          "name": "Login (admin) — guarda token + userId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Header Authorization con Bearer token', () => {",
                  "    const auth = pm.response.headers.get('Authorization');",
                  "    pm.expect(auth).to.be.a('string');",
                  "    pm.expect(auth).to.match(/^Bearer\\s+/);",
                  "});",
                  "pm.test('Body contiene UserDto del usuario logueado', () => {",
                  "    const u = pm.response.json();",
                  "    pm.expect(u).to.have.property('id');",
                  "    pm.expect(u).to.have.property('email', 'admin@dexter.app');",
                  "});",
                  "",
                  "// Guardar token y userId en variables de colección",
                  "const authHeader = pm.response.headers.get('Authorization');",
                  "if (authHeader) {",
                  "    const token = authHeader.replace(/^Bearer\\s+/i, '').trim();",
                  "    pm.collectionVariables.set('token', token);",
                  "    console.log('Token guardado:', token.substring(0, 20) + '...');",
                  "}",
                  "const body = pm.response.json();",
                  "if (body && body.id) {",
                  "    pm.collectionVariables.set('userId', String(body.id));",
                  "    console.log('userId guardado:', body.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"admin@dexter.app\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "login"
              ]
            },
            "description": "Login vía JwtAuthenticationFilter. El JWT viene en el header Authorization. El test extrae el token y el userId y los guarda en variables de colección."
          }
        },
