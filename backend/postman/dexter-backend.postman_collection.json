                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Content-Type application/json', () => pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'));",
                  "pm.test('Respuesta contiene status:ok', () => {",
                  "    const body = pm.response.json();",
                  "    pm.expect(body).to.have.property('status', 'ok');",
                  "    pm.expect(body).to.have.property('environment');",
                  "});",
                  "pm.test('Tiempo de respuesta < 500ms', () => pm.expect(pm.response.responseTime).to.be.below(500));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            },
            "description": "Smoke test público. Esperado: 200 {\"status\":\"ok\",\"environment\":\"dev\"}"
          }
        },
        {
          "name": "Register (nuevo usuario)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('Respuesta es UserDto válido', () => {",
                  "    const u = pm.response.json();",
                  "    pm.expect(u).to.have.property('id').that.is.a('number');",
                  "    pm.expect(u).to.have.property('email').that.is.a('string');",
                  "    pm.expect(u).to.have.property('password').that.is.a('string');",
                  "    pm.expect(u.password).to.match(/^\\$2[ab]\\$/, 'password debe estar hasheado con BCrypt');",
                  "    pm.expect(u).to.have.property('firstName', 'Newman');",
                  "    pm.expect(u).to.have.property('enabled', true);",
                  "});",
                  "pm.test('Email coincide con el enviado', () => {",
                  "    const sent = JSON.parse(pm.request.body.raw).email;",
                  "    pm.expect(pm.response.json().email).to.equal(sent);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
